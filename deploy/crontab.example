# Every 12 hours. The daily close scan can be scheduled separately if desired.
0 */12 * * * cd /home/ubuntu/reversal-bot && /home/ubuntu/reversal-bot/.venv/bin/python scanner.py >> /home/ubuntu/reversal-bot/reversal.log 2>&1

# Optional daily close scan at 00:05 UTC.
5 0 * * * cd /home/ubuntu/reversal-bot && /home/ubuntu/reversal-bot/.venv/bin/python scanner.py >> /home/ubuntu/reversal-bot/reversal.log 2>&1
